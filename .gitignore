# Python bytecode
__pycache__/
*.pyc

# Secrets and runtime locks
/config/terminus-bar/private/
/config/.settings.lock

# Build output
/modules/terminus-bar-menu-blur/build/
/modules/hyprland-plugins/*/build/
/modules/overlays/*/build/

# Mood sounds users copy in (the tracked ones stay tracked)
/modules/desktop/mood/

# Regenerated by terminus-settings, the wallpaper sync or Terminus-Bar templates
/config/generated/
/config/terminus-bar/palettes/Skwd Wall.json
/config/terminus-bar/95-skwd-font.toml
/config/terminus-bar/99-terminus-appearance.toml
/config/zed/themes/terminus-est.json
/config/swayosd/style.css
/config/terminus-launcher/theme.json
/config/login/appearance.json
/config/ghostty/themes/terminusbar
