#!/bin/bash
# Terminus-Screensaver: the owned non-authenticating Ghostty/TTE overlay.
# launch/force start a systemd service running --session, which opens one Ghostty per monitor; each runs --render.
# Hot path: --render polls once a second (read + hyprctl + jq) while the effect plays.
set -u
umask 077
helper_path=$(readlink -f "${BASH_SOURCE[0]}")
readonly helper_path
readonly config_root="${XDG_CONFIG_HOME:-${HOME:?HOME is required}/.config}/terminus-est"
readonly runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/terminus-screensaver"
readonly service_unit=terminus-screensaver.service
readonly usage='Usage: terminus-screensaver [launch|force|--running|--stop|--resume|--render --monitor CONNECTOR [--artwork owl|meow]]'

readonly resume_grace_us=1500000 # a hypridle resume this soon after "ready" is the launcher's own focus change
readonly window_poll_attempts=50 # polls at 0.1 s: a Ghostty window maps, or a renderer registers
readonly hold_seconds=60         # how long the finished artwork stays up, still accepting dismissal
readonly font_size_landscape=18
readonly font_size_portrait=28

# Command line, filled by parse_arguments
action=launch
force=false
monitor=
artwork=

# Settings, filled by load_settings (generated settings are parsed as allowlisted data, never shell-sourced)
enabled=true
style=per-monitor
fps=120

# Runtime ownership and process identity
[[ ! -L $runtime_dir ]] || {
  echo 'Invalid Terminus-Screensaver runtime symlink' >&2
  exit 1
}
mkdir -p "$runtime_dir" || exit 1
[[ -d $runtime_dir && -O $runtime_dir && ! -L $runtime_dir ]] || exit 1
chmod 700 "$runtime_dir" || exit 1

# A state file in the runtime dir counts only when it is a regular file we own.
owned_file() { [[ -f $1 && ! -L $1 && -O $1 ]]; }

# Portrait monitors have an odd transform (1, 3, 5, 7).
valid_connector() { [[ $1 =~ ^[A-Za-z0-9_.:-]+$ ]]; }
is_portrait() { [[ $1 =~ ^[1357]$ ]]; }

# /proc entries can vanish between listing and reading; a missing entry is a
# non-match and stays silent (the redirect order keeps open errors quiet too).
helper_matches() {
  local pid=$1 arg candidate found=false
  [[ $pid =~ ^[1-9][0-9]*$ && -O /proc/$pid && -r /proc/$pid/cmdline ]] || return 1
  {
    while IFS= read -r -d '' arg; do
      [[ $arg == */terminus-screensaver ]] || continue
      candidate=$(readlink -f "$arg" 2>/dev/null) || continue
      [[ $candidate == "$helper_path" ]] && found=true
    done
  } 2>/dev/null <"/proc/$pid/cmdline"
  [[ $found == true ]]
}

renderer_matches() {
  local pid=$1 arg
  helper_matches "$pid" || return 1
  {
    while IFS= read -r -d '' arg; do
      [[ $arg == --render ]] && return 0
    done
  } 2>/dev/null <"/proc/$pid/cmdline"
  return 1
}

# Fills renderer_pids with the live registered renderers and removes stale registrations.
collect_renderers() {
  local pid_file pid registered
  renderer_pids=()
  for pid_file in "$runtime_dir"/*.pid; do
    [[ -e $pid_file || -L $pid_file ]] || continue
    if [[ -L $pid_file || ! -f $pid_file || ! -O $pid_file ]]; then
      continue
    fi
    pid=${pid_file##*/}
    pid=${pid%.pid}
    IFS= read -r registered <"$pid_file" || registered=
    if [[ ! $pid =~ ^[1-9][0-9]*$ || $registered != "$pid" ]] || ! renderer_matches "$pid"; then
      rm -f "$pid_file"
      continue
    fi
    renderer_pids+=("$pid")
  done
}

restore_cursor() {
  hyprctl -q eval 'hl.config({ cursor = { invisible = false } })'
}

# TERM, wait up to 2.5 s, then KILL; then give the cursor and the keybind submap back.
stop_renderers() {
  local pid attempt alive status=0
  collect_renderers
  for pid in "${renderer_pids[@]}"; do
    renderer_matches "$pid" && kill -TERM "$pid" 2>/dev/null || true
  done
  for ((attempt = 0; attempt < 50; attempt++)); do
    alive=false
    for pid in "${renderer_pids[@]}"; do
      if renderer_matches "$pid"; then
        alive=true
        break
      fi
    done
    [[ $alive == false ]] && break
    sleep 0.05
  done
  for pid in "${renderer_pids[@]}"; do
    renderer_matches "$pid" && kill -KILL "$pid" 2>/dev/null || true
  done
  collect_renderers
  restore_cursor || status=1
  hyprctl -q dispatch 'hl.dsp.submap("reset")' || status=1
  return "$status"
}

# CLI contract
parse_arguments() {
  case ${1:-} in
    '') ;;
    launch) shift ;;
    force)
      action=launch
      force=true
      shift
      ;;
    --running)
      action=running
      shift
      ;;
    --stop)
      action=stop
      shift
      ;;
    --resume)
      action=resume
      shift
      ;;
    --render)
      action=render
      shift
      ;;
    --session)
      action=session
      force=true
      shift
      ;;
    --cleanup)
      action=cleanup
      shift
      ;;
    *)
      echo "$usage" >&2
      exit 2
      ;;
  esac
  if [[ $action == render && ${1:-} == --monitor && ($# == 2 || ($# == 4 && ${3:-} == --artwork)) ]]; then
    monitor=$2
    (($# == 4)) && artwork=$4
    shift $#
  fi
  if (($#)) || [[ -n $artwork && ! $artwork =~ ^(owl|meow)$ ]] || { [[ $action == render ]] && ! valid_connector "$monitor"; }; then
    echo "$usage" >&2
    exit 2
  fi
}

# hypridle reads the launcher's own monitor focus changes as user activity.
# Ignore resumes while a launch runs and briefly after it publishes ready.
resume() {
  local launcher ready_at
  if owned_file "$runtime_dir/launching"; then
    IFS= read -r launcher <"$runtime_dir/launching" && helper_matches "$launcher" && exit 0
  fi
  if owned_file "$runtime_dir/ready"; then
    IFS= read -r ready_at <"$runtime_dir/ready" || ready_at=
    if [[ $ready_at =~ ^[0-9]+\.[0-9]+$ ]] && ((${EPOCHREALTIME/./} - ${ready_at/./} < resume_grace_us)); then exit 0; fi
  fi
  exec "$helper_path" --stop
}

stop() {
  # The service manager waits for ExecStopPost, including after SIGKILL.
  if systemctl --user cat "$service_unit" >/dev/null 2>&1; then
    systemctl --user stop "$service_unit" || exit 1
  fi
  stop_renderers
  exit $?
}

# Value must be a plain decimal in [min, max].
integer_in_range() { [[ $1 =~ ^[1-9][0-9]{0,3}$ ]] && (($1 >= $2 && $1 <= $3)); }

load_settings() {
  local settings=$config_root/generated/screensaver.env key value
  local -A seen=()
  if [[ ! -f $settings ]]; then
    echo 'Terminus-Screensaver settings missing; run terminus-settings render first.' >&2
    exit 1
  fi
  while IFS='=' read -r key value || [[ -n ${key:-} ]]; do
    [[ -z $key || $key == \#* ]] && continue
    [[ -z ${seen[$key]:-} ]] || {
      echo 'Duplicate saver setting' >&2
      exit 1
    }
    seen[$key]=1
    case $key in
      TERMINUS_SCREENSAVER_ENABLED)
        [[ $value == true || $value == false ]] || exit 1
        enabled=$value
        ;;
      TERMINUS_SCREENSAVER_STYLE)
        [[ $value == per-monitor || $value == wordmark || $value == arcade ]] || exit 1
        style=$value
        ;;
      TERMINUS_SCREENSAVER_FPS)
        integer_in_range "$value" 15 144 || exit 1
        fps=$value
        ;;
      TERMINUS_SCREENSAVER_IDLE_SECONDS)
        # Read by hypridle's generated config; only validated here.
        integer_in_range "$value" 30 7200 || exit 1
        ;;
      *)
        echo "Unknown Terminus-Screensaver setting: $key" >&2
        exit 1
        ;;
    esac
  done <"$settings"
  ((${#seen[@]} == 4)) || {
    echo 'Incomplete saver settings' >&2
    exit 1
  }
}

require_dependencies() {
  local dependency
  for dependency in tte ghostty hyprctl jq systemd-run systemd-notify; do
    command -v "$dependency" >/dev/null 2>&1 || {
      echo "Terminus-Screensaver requires $dependency" >&2
      exit 1
    }
  done
}

# Serialize callers, but let systemd own the cursor lifetime independently of
# Ghostty's terminal/process group. Renderers never change global cursor state.
launch() {
  [[ ! -L $runtime_dir/launch.lock ]] || exit 1
  exec 9>"$runtime_dir/launch.lock"
  flock -n 9 || exit 0
  collect_renderers
  if ((${#renderer_pids[@]})); then
    if [[ $force == true ]]; then stop_renderers; else exit 0; fi
  fi
  [[ $enabled == true || $force == true ]] || exit 1
  if systemctl --user is-active --quiet "$service_unit"; then
    [[ $force == true ]] || exit 0
  fi
  if systemctl --user cat "$service_unit" >/dev/null 2>&1; then
    systemctl --user stop "$service_unit" || exit 1
  fi
  exec systemd-run --user --quiet --collect --unit="$service_unit" \
    --service-type=notify --property=NotifyAccess=all \
    --property=TimeoutStartSec=30 --property=TimeoutStopSec=5 \
    "--property=ExecStopPost=\"$helper_path\" --cleanup" \
    --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=WAYLAND_DISPLAY \
    --setenv=XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" \
    "$helper_path" --session
}

# Session
# Runs under the service: remembers the focused monitor, spawns the renderers, flips cursor and submap, then waits.

focused= # monitor to refocus when the session ends or is interrupted

focus_monitor() {
  valid_connector "$1" || return 1
  hyprctl -q dispatch "hl.dsp.focus({ monitor = \"$1\" })"
}

# EXIT trap while launching: put focus back, whatever stopped us.
launch_cleanup() {
  local status=$?
  trap - EXIT
  trap '' SIGINT SIGTERM SIGHUP SIGQUIT
  rm -f "$runtime_dir/launching"
  [[ -n $focused ]] && focus_monitor "$focused" >/dev/null 2>&1 || true
  exit "$status"
}

# A host with hosts/<hostname>/screensaver-art (the laptop) shows the owl, and the meow 1 time in 100.
# Drawn once per session so every monitor shows the same artwork. Prints nothing when the host has none.
pick_session_artwork() {
  local host draw
  host=$(</etc/hostname) 2>/dev/null || host=
  [[ $host =~ ^[A-Za-z0-9._-]+$ && -f $config_root/hosts/$host/screensaver-art ]] || return 0
  # Rejection sampling: 32700 is the largest multiple of 100 below RANDOM's range, so draw % 100 is uniform.
  while true; do
    draw=$RANDOM
    ((draw < 32700)) && break
  done
  if ((draw % 100 == 0)); then echo meow; else echo owl; fi
}

# Host artwork scales with logical height; the 31-line meow gets a smaller font so its footer stays visible.
artwork_font_size() {
  local monitor=$1 art=$2
  hyprctl monitors -j | jq -er --arg monitor "$monitor" --arg artwork "$art" '
    .[] | select(.name == $monitor)
    | ((if (.transform % 2) == 1 then .width else .height end) / .scale) as $height
    | if $artwork == "meow" then
        (($height / 60) | round | if . < 16 then 16 elif . > 32 then 32 else . end)
      else
        (($height / 50) | round | if . < 18 then 18 elif . > 40 then 40 else . end)
      end
  '
}

# True once a screensaver window is mapped on the monitor.
wait_for_window() {
  local monitor=$1 attempt monitor_id
  for ((attempt = 0; attempt < window_poll_attempts; attempt++)); do
    monitor_id=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | .id')
    if [[ $monitor_id =~ ^[0-9]+$ ]] && hyprctl clients -j | jq -e --argjson monitor "$monitor_id" 'any(.[]; .class == "org.terminus.screensaver" and .monitor == $monitor)' >/dev/null; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# Launch one dedicated terminal on a monitor and wait until its window is mapped.
launch_renderer() {
  local monitor=$1 transform=$2 art=$3 font_size=$font_size_landscape command escaped
  local -a argv
  is_portrait "$transform" && font_size=$font_size_portrait
  if [[ -n $art ]]; then
    font_size=$(artwork_font_size "$monitor" "$art") || exit 1
  fi
  focus_monitor "$monitor" || exit 1
  argv=(ghostty --class=org.terminus.screensaver "--config-file=$config_root/terminus-screensaver/ghostty.conf" "--font-size=$font_size" -e "$helper_path" --render --monitor "$monitor")
  [[ -z $art ]] || argv+=(--artwork "$art")
  printf -v command '%q ' "${argv[@]}"
  # Paths may contain Lua long-string delimiters; use a JSON-escaped Lua string.
  escaped=$(printf '%s' "$command" | jq -Rs .) || exit 1
  hyprctl -q dispatch "hl.dsp.exec_cmd($escaped)" || exit 1
  wait_for_window "$monitor" || exit 1
}

session() {
  local -a monitors=() monitor_rows
  local -A monitor_transform=()
  local row monitor transform art attempt
  [[ -n ${NOTIFY_SOCKET:-} ]] || {
    echo '--session requires its user service' >&2
    exit 1
  }
  [[ -r $config_root/terminus-screensaver/ghostty.conf ]] || {
    echo 'Dedicated saver Ghostty configuration missing' >&2
    exit 1
  }
  focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
  trap launch_cleanup EXIT
  trap 'exit 1' SIGINT SIGTERM SIGHUP SIGQUIT
  [[ ! -L $runtime_dir/launching ]] || exit 1
  printf '%s\n' "$$" >"$runtime_dir/launching"
  mapfile -t monitor_rows < <(hyprctl monitors -j | jq -r '.[] | [.name, .transform] | @tsv')
  ((${#monitor_rows[@]} > 0)) || exit 1
  for row in "${monitor_rows[@]}"; do
    IFS=$'\t' read -r monitor transform <<<"$row"
    valid_connector "$monitor" && [[ $transform =~ ^[0-7]$ ]] || exit 1
    [[ -z ${monitor_transform[$monitor]:-} ]] || exit 1 # connector names are unique; a repeat is a corrupt listing
    monitors+=("$monitor")
    monitor_transform[$monitor]=$transform
  done
  art=$(pick_session_artwork)
  for monitor in "${monitors[@]}"; do
    launch_renderer "$monitor" "${monitor_transform[$monitor]}" "$art"
  done
  # Mapping precedes renderer initialization; don't publish readiness or hide
  # the pointer until every renderer has registered.
  for ((attempt = 0; attempt < window_poll_attempts; attempt++)); do
    collect_renderers
    ((${#renderer_pids[@]} == ${#monitors[@]})) && break
    sleep 0.1
  done
  ((${#renderer_pids[@]} == ${#monitors[@]})) || exit 1
  hyprctl -q dispatch 'hl.dsp.submap("screensaver")' || exit 1
  hyprctl -q eval 'hl.config({ cursor = { invisible = true } })' || exit 1
  [[ -n $focused ]] && focus_monitor "$focused" >/dev/null 2>&1 || true
  focused=
  printf '%s\n' "$EPOCHREALTIME" >"$runtime_dir/ready"
  rm -f "$runtime_dir/launching"
  systemd-notify --ready || exit 1
  # Once ready, a stop request (SIGTERM from systemctl stop) is a normal dismissal.
  trap 'exit 0' SIGINT SIGTERM SIGHUP SIGQUIT
  while true; do
    collect_renderers
    ((${#renderer_pids[@]} == ${#monitors[@]})) || break
    sleep 0.2
  done
  exit 0
}

# Renderer
# One per monitor, inside its Ghostty: plays TTE effects on the artwork until a key press or a focus change.

renderer_pid=$$
renderer_tty=
pid_file=$runtime_dir/$$.pid
tte_pid=

tte_is_owned() {
  local child_tty arg key value parent=
  [[ -n $tte_pid && -O /proc/$tte_pid && -r /proc/$tte_pid/cmdline ]] || return 1
  child_tty=$(readlink -f "/proc/$tte_pid/fd/0" 2>/dev/null) || return 1
  [[ $child_tty == "$renderer_tty" ]] || return 1
  while IFS=: read -r key value; do
    [[ $key == PPid ]] && parent=${value//[[:space:]]/}
  done <"/proc/$tte_pid/status"
  [[ $parent == "$renderer_pid" ]] || return 1
  while IFS= read -r -d '' arg; do
    [[ $arg == tte || $arg == */tte ]] && return 0
  done <"/proc/$tte_pid/cmdline"
  return 1
}

cleanup_renderer() {
  local status=$? attempt registered
  trap - EXIT
  trap '' SIGINT SIGTERM SIGHUP SIGQUIT
  if tte_is_owned; then
    kill -TERM "$tte_pid" 2>/dev/null || true
    for ((attempt = 0; attempt < 20; attempt++)); do
      tte_is_owned || break
      sleep 0.05
    done
    tte_is_owned && kill -KILL "$tte_pid" 2>/dev/null || true
    wait "$tte_pid" 2>/dev/null || true
  fi
  if owned_file "$pid_file"; then
    registered=
    IFS= read -r registered <"$pid_file" || true
    [[ $registered == "$renderer_pid" ]] && rm -f "$pid_file"
  fi
  exit "$status"
}

launch_in_progress() {
  local launcher
  owned_file "$runtime_dir/launching" || return 1
  IFS= read -r launcher <"$runtime_dir/launching" || return 1
  helper_matches "$launcher"
}

screensaver_in_focus() {
  launch_in_progress && return 0
  hyprctl activewindow -j | jq -e '.class == "org.terminus.screensaver"' >/dev/null 2>&1
}

tte_is_running() {
  local key value
  tte_is_owned || return 1
  while IFS=: read -r key value; do
    if [[ $key == State ]]; then
      [[ $value != *Z* ]]
      return
    fi
  done <"/proc/$tte_pid/status"
  return 1
}

# Waits up to one second for a key press. A key, or focus leaving the saver, dismisses it.
dismissal_requested() { read -rsn1 -t 1 || ! screensaver_in_focus; }

dismiss() {
  "$helper_path" --stop >/dev/null 2>&1 &
  exit 0
}

# Portrait monitors get the arcade art under per-monitor; every monitor's frame rate is capped at its own refresh rate.
render() {
  local monitor_info transform refresh frame_rate input attempt hold result portrait=false
  monitor_info=$(hyprctl monitors -j | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | [.transform, (.refreshRate | round)] | @tsv') || exit 1
  IFS=$'\t' read -r transform refresh <<<"$monitor_info"
  [[ $transform =~ ^[0-7]$ && $refresh =~ ^[0-9]+$ ]] || {
    echo "Terminus-Screensaver cannot read monitor properties: $monitor" >&2
    exit 1
  }
  is_portrait "$transform" && portrait=true
  frame_rate=$fps
  ((refresh > 0 && frame_rate > refresh)) && frame_rate=$refresh
  input="$config_root/terminus-screensaver/terminus-wordmark.txt"
  if [[ $style == arcade || ($style == per-monitor && $portrait == true) ]]; then
    input="$config_root/terminus-screensaver/space-invader.txt"
  fi
  [[ -z $artwork ]] || input="$config_root/terminus-screensaver/$artwork.txt"
  [[ -r $input ]] || {
    echo "Terminus-Screensaver artwork unreadable: $input" >&2
    exit 1
  }
  renderer_tty=$(tty 2>/dev/null)
  [[ $renderer_tty == /dev/pts/* || $renderer_tty == /dev/tty* ]] || {
    echo 'Terminus-Screensaver renderer requires a terminal' >&2
    exit 1
  }

  trap cleanup_renderer EXIT
  trap 'exit 0' SIGINT SIGTERM SIGHUP SIGQUIT
  [[ ! -e $pid_file && ! -L $pid_file ]] || exit 1
  printf '%s\n' "$renderer_pid" >"$pid_file"
  printf '\033]11;rgb:00/00/00\007'
  while true; do
    nice -n 19 tte -i "$input" --frame-rate "$frame_rate" --canvas-width 0 --canvas-height 0 --reuse-canvas \
      --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor <"$renderer_tty" &
    tte_pid=$!
    # Bash gives asynchronous jobs /dev/null unless stdin is explicitly retained.
    # Wait through fork/exec before applying the TTE identity/terminal checks.
    for ((attempt = 0; attempt < 50; attempt++)); do
      tte_is_owned && break
      kill -0 "$tte_pid" 2>/dev/null || break
      sleep 0.01
    done
    while tte_is_running; do
      if dismissal_requested; then dismiss; fi
    done
    wait "$tte_pid"
    result=$?
    tte_pid=
    if ((result != 0)); then
      echo "Terminus-Screensaver TTE effect exited with status $result" >&2
      "$helper_path" --stop >/dev/null 2>&1 &
      exit "$result"
    fi
    # Leave the completed artwork visible (idle, ~0% CPU), still accepting dismissal.
    for ((hold = 0; hold < hold_seconds; hold++)); do
      if dismissal_requested; then dismiss; fi
    done
  done
}

parse_arguments "$@"
case $action in
  running)
    collect_renderers
    ((${#renderer_pids[@]} > 0))
    exit
    ;;
  resume) resume ;;
  stop) stop ;;
  cleanup)
    stop_renderers
    exit $?
    ;;
esac
load_settings
require_dependencies
case $action in
  launch) launch ;;
  session) session ;;
  render) render ;;
esac
