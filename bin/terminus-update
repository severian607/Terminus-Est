#!/usr/bin/env bash
# Terminus-Est update: fast-forward from GitHub, then bring the machine in line with what changed.
#   terminus-update           pull and apply; exit status shows failures
#   terminus-update --hook    same, but never fails; the bar build runs detached (pacman hook after yay/pacman upgrades)
# No -e: every step may fail on its own and the rest still apply; --hook must never fail.
set -uo pipefail

hook=0
[[ ${1:-} == --hook ]] && hook=1
root=$(dirname "$(dirname "$(readlink -f "$0")")")
failed=0
say() { echo "terminus-update: $*"; }
# A step failed: say so and remember it for the exit status (--hook still exits 0).
fail() {
  say "$*"
  failed=1
}
stop() {
  say "$*"
  exit $((1 - hook))
}

cd "$root" || exit $((1 - hook))
# The hook runs outside the session; find the user bus and the running compositor.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[[ -S $XDG_RUNTIME_DIR/bus ]] && export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} && -d $XDG_RUNTIME_DIR/hypr ]]; then
  # shellcheck disable=SC2012  # entries are instance signatures (hex and underscores), safe to parse
  signature=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)
  [[ -n $signature ]] && export HYPRLAND_INSTANCE_SIGNATURE=$signature
fi

build_bar() {
  local bar=$root/modules/terminus-bar
  say "building terminusbar (this can take several minutes)"
  [[ -f $bar/build-release/build.ninja ]] || meson setup "$bar/build-release" "$bar" -Dbuildtype=release -Dcpp_std=c++23 -Dtests=disabled >/dev/null
  local jobs=$(($(nproc) / 2))
  ((jobs > 0)) || jobs=1
  if ninja -C "$bar/build-release" -j"$jobs" terminusbar >/dev/null; then
    systemctl --user try-restart terminus-bar.service
  else
    fail "bar build failed; the previous binary stays in use"
  fi
}
# rebuild_plugin DIR LABEL: rebuild a Hyprland plugin and report the outcome.
rebuild_plugin() {
  if make -B -C "$1" >/dev/null 2>&1; then
    say "rebuilt the $2 plugin"
  else
    fail "$2 plugin did not build"
  fi
}

if [[ ${1:-} == --build-bar ]]; then
  build_bar
  exit "$failed"
fi
export PATH="$root/bin:$HOME/.local/bin:$PATH"

# merge_local_wins DIR: three-way merge of DIR/{local,base,upstream} to stdout. Where both sides changed the same
# lines the local side wins (a key upstream added right beside such a line is dropped with it; settings fall back
# to their defaults). A non-zero status means the file cannot be merged line by line (binary).
merge_local_wins() {
  git merge-file -p --ours "$1/local" "$1/base" "$1/upstream"
}

# Re-apply the stash taken before the pull. Where local and upstream changed the same lines the local side wins;
# every other change from both sides is kept. A file that cannot be merged line by line (binary, deleted on one
# side) is left as upstream's version and the local copy is saved. No conflict marker or unmerged entry survives,
# and the stash is dropped only when every file is settled.
reapply_local() {
  local -a unmerged resolved=() staged
  local path stages tmp saved
  if git stash apply --quiet >/dev/null 2>&1; then
    git stash drop --quiet
    return 0
  fi
  mapfile -t unmerged < <(git diff --name-only --diff-filter=U)
  if ((${#unmerged[@]} == 0)); then
    fail "could not re-apply your local changes; they stay in 'git stash'"
    return 1
  fi
  tmp=$(mktemp -d)
  saved=$HOME/.local/state/terminus-est/update-local/$(date +%Y%m%d-%H%M%S)
  for path in "${unmerged[@]}"; do
    # Stage 1 is the common base, 2 upstream, 3 the local change.
    stages=$(git ls-files -u -- "$path" | awk '{print $3}' | sort -u | tr -d '\n')
    if [[ $stages == 123 ]] &&
      git show ":1:$path" >"$tmp/base" && git show ":2:$path" >"$tmp/upstream" && git show ":3:$path" >"$tmp/local" &&
      merge_local_wins "$tmp" >"$tmp/merged"; then
      cat "$tmp/merged" >"$path"
      resolved+=("$path")
      say "$path: upstream and your changes merged; yours won where they overlapped"
    else
      if [[ $stages == *3* ]]; then
        mkdir -p "$saved/$(dirname "$path")"
        git show ":3:$path" >"$saved/$path"
      fi
      if [[ $stages == *2* ]]; then
        git checkout HEAD -- "$path"
      else
        git rm -q -f --cached -- "$path"
        rm -f -- "$path"
      fi
      fail "$path: could not be merged; upstream's version is in place, your copy is in $saved/$path"
    fi
  done
  rm -rf "$tmp"
  # The failed apply also staged the files it merged cleanly; leave every tracked file merely modified, as a plain apply would.
  mapfile -t staged < <(git diff --cached --name-only --diff-filter=M)
  resolved+=("${staged[@]}")
  ((${#resolved[@]})) && git reset -q -- "${resolved[@]}"
  if [[ -z $(git ls-files -u) ]]; then
    git stash drop --quiet
  else
    fail "some files are still unmerged; your changes stay in 'git stash'"
  fi
}

# Fast-forward without --autostash, which can leave conflict markers in tracked files: set local changes aside,
# pull, put them back.
update_checkout() {
  local stashed=0 stash_before
  if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
    stash_before=$(git rev-parse -q --verify refs/stash || true)
    git stash push --quiet -m "terminus-update autostash" >/dev/null 2>&1
    [[ $(git rev-parse -q --verify refs/stash || true) != "$stash_before" ]] || stop "could not set local changes aside; nothing changed"
    stashed=1
  fi
  git pull --ff-only --quiet 2>&1 | sed 's/^/terminus-update: /'
  if [[ ${PIPESTATUS[0]} -ne 0 ]]; then
    # The pull changed nothing, so the stash applies back cleanly.
    ((stashed)) && { git stash pop --quiet >/dev/null 2>&1 || say "could not restore your local changes; they stay in 'git stash'"; }
    stop "pull failed (no network, no sign-in, or local commits); nothing changed"
  fi
  ((stashed)) && reapply_local
  return 0
}

before=$(git rev-parse HEAD)
update_checkout
after=$(git rev-parse HEAD)
changed=$(git diff --name-only "$before" "$after")
changed_in() { grep -q -E "$1" <<<"$changed"; }

if [[ $before == "$after" ]]; then
  say "already up to date ($(git rev-parse --short HEAD))"
else
  say "updated $(git rev-parse --short "$before") -> $(git rev-parse --short "$after")"
fi

# Units and bus services added to the tree need a link before systemd and D-Bus see them.
reload=0
for pair in "config/systemd/user:$HOME/.config/systemd/user" "config/dbus-1/services:$HOME/.local/share/dbus-1/services"; do
  source_dir=$root/${pair%%:*}
  target_dir=${pair##*:}
  mkdir -p "$target_dir"
  for file in "$source_dir"/*; do
    [[ -f $file && ! -e $target_dir/$(basename "$file") && ! -L $target_dir/$(basename "$file") ]] || continue
    ln -s "$file" "$target_dir/$(basename "$file")" && reload=1 && say "linked $(basename "$file")"
  done
done
changed_in '^config/systemd/user/' && reload=1
((reload)) && systemctl --user daemon-reload

# The bar is built on this machine; rebuild when its sources changed or no binary exists.
bar=$root/modules/terminus-bar
if changed_in '^modules/terminus-bar/(src|include|subprojects)/|^modules/terminus-bar/meson' || [[ ! -x $bar/build-release/terminusbar ]]; then
  if ((hook)); then
    # Inside the pacman transaction the lock is held; build in a user unit instead.
    if systemd-run --user --no-block --collect --quiet --unit=terminus-bar-build "$root/bin/terminus-update" --build-bar; then
      say "bar build started in the background (journalctl --user -u terminus-bar-build)"
    else
      build_bar
    fi
  else
    build_bar
  fi
fi

# The menu blur plugin must match the installed Hyprland.
plugin=$root/modules/terminus-bar-menu-blur
if pkg-config --exists hyprland 2>/dev/null &&
  { [[ ! -f $plugin/build/terminus-bar-menu-blur.so ]] || [[ $plugin/build/terminus-bar-menu-blur.so -ot /usr/bin/Hyprland ]] ||
    changed_in '^modules/terminus-bar-menu-blur/'; }; then
  rebuild_plugin "$plugin" "menu blur"
fi

# So must the plugins behind the motion picker's window and pointer effects; a stale one is refused by Hyprland.
if pkg-config --exists hyprland 2>/dev/null; then
  for plugin in "$root"/modules/hyprland-plugins/*/; do
    plugin=${plugin%/}
    artifact=$plugin/build/${plugin##*/}.so
    if [[ ! -f $artifact || $artifact -ot /usr/bin/Hyprland ]] || changed_in "^modules/hyprland-plugins/${plugin##*/}/"; then
      rebuild_plugin "$plugin" "${plugin##*/}"
    fi
  done
fi

# Launcher and picker services read their code at start.
changed_in '^modules/terminus-launcher/|^lib/skin_launcher.py' && systemctl --user try-restart terminus-launcher.service
# The pickers run lib/shader_panel.py (keysounds included) and import picker_style, which imports settings and tokens.
changed_in '^lib/(shader_panel|picker_style|settings|tokens)\.py' &&
  systemctl --user try-restart terminus-shaders.service terminus-audio.service terminus-motion.service terminus-keysounds.service
changed_in '^lib/(symbol_panel|picker_style|settings|tokens)\.py' && systemctl --user try-restart terminus-symbols.service
changed_in '^modules/terminus-bar-plugins/vitals/bin/vitals-log' && systemctl --user try-restart terminus-vitals-log.service

# The login screen helper runs as root from /usr/local/libexec; a stale copy only changes with sudo.
login_apply=/usr/local/libexec/terminus-login-apply
if [[ -f $login_apply ]] && ! cmp -s "$login_apply" "$root/tools/terminus-login-apply"; then
  say "the root copy of terminus-login-apply is out of date; run:"
  say "  sudo install -o root -g root -m 0755 $root/tools/terminus-login-apply $login_apply"
fi

terminus-settings apply >/dev/null 2>&1 || fail "terminus-settings apply failed; run it by hand"
if changed_in '^config/(hyprland|hosts)/'; then
  if hyprctl reload >/dev/null 2>&1; then
    say "reloaded Hyprland"
  else
    say "Hyprland is not running; the change applies at next start"
  fi
fi
exit $((failed && ! hook))
