#!/bin/bash
# Focused-window transparency (runs on a key press): Obsidian toggles blur, every other window toggles opacity.
set -euo pipefail

# Hyprland prints "{}" when no window is focused, leaving the address empty.
IFS=$'\t' read -r address class < <(hyprctl activewindow -j | jq -r '[.address // "", .class // ""] | @tsv')
[[ -n $address ]] || exit 0

# set_prop PROP VALUE: Lua dispatcher on the focused window, by address.
set_prop() {
  hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"$1\", value = \"$2\", window = \"address:$address\" })"
}

if [[ ${class,,} == *obsidian* ]]; then
  next_no_blur=1
  [[ $(hyprctl getprop "address:$address" no_blur) == true ]] && next_no_blur=0
  set_prop opaque 0 >/dev/null
  set_prop no_blur "$next_no_blur"
else
  set_prop opaque toggle
fi
