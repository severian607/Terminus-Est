#!/usr/bin/env python3
# Terminus-Est primary desktop dispatcher.
# Runs on key presses (`terminus compat ...`): import only os/sys at top level, so start-up stays near bare Python.
import os
import sys

PROJECT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DESKTOP = os.path.join(PROJECT, "modules/desktop")
os.environ["TERMINUS_PATH"] = PROJECT
os.environ["TERMINUS_DESKTOP_PATH"] = DESKTOP
os.environ["PATH"] = os.pathsep.join(
    (os.path.join(PROJECT, "bin"), os.path.join(DESKTOP, "bin"), os.environ.get("PATH", ""))
)

HELP = """Terminus-Est unified desktop
  terminus bar [native arguments]         Terminus-Bar
  terminus settings [section]             Open Terminus-Settings
  terminus settings {get,schema,validate,render,set,reset,apply,login-apply} ...
  terminus menu [NAME [arguments]]        Open Terminus-Settings, or run a desktop menu
  terminus launcher [toggle|mode NAME]    Terminus-Launcher
  terminus screensaver [force|--stop|--running]
  terminus system lock                    Non-authenticating Terminus-Screensaver
  terminus restart {bar,launcher,hypridle,swayosd}
                                          Idle restarts preserve a paused owner.
  terminus refresh {appearance,settings} [--dry-run]
  terminus compat HELPER [arguments]      Explicit desktop helper
  terminus GROUP COMMAND [arguments]      Other desktop operations
Configuration: ~/.config/terminus-est; maintained helpers: modules/desktop.
Menus, application launching and appearance use the native desktop modules.
Broad configuration resets are disabled; recovery is recorded in the
maintained Terminus-Est ownership map."""

HELPER_NAME_CHARS = frozenset("abcdefghijklmnopqrstuvwxyz0123456789")
# `compat PREFIX-REST` is the upstream spelling of the group command `PREFIX REST`.
COMPAT_GROUP_PREFIXES = ("launch-", "restart-", "refresh-", "system-", "branding-")
# Programs this repository owns, by group command (`terminus bar ...`).
OWNED_PROGRAMS = {"bar": "terminus-bar", "launcher": "terminus-launcher", "screensaver": "terminus-screensaver"}
# `terminus launch TARGET ...` targets.
LAUNCH_PROGRAMS = {
    "launcher": "terminus-launcher",
    "screensaver": "terminus-screensaver",
    "settings": "terminus-settings",
    "menu": "terminus-settings",
}
RESTART_UNITS = {
    "bar": "terminus-bar.service",
    "launcher": "terminus-launcher.service",
    "swayosd": "swayosd-server.service",
}
SYSTEMCTL = "/usr/bin/systemctl"


def run(program, *args):
    os.execv(program, [program, *args])


def reject(message):
    print("Terminus-Est: " + message, file=sys.stderr)
    raise SystemExit(2)


def desktop(name, *args):
    program = os.path.join(DESKTOP, "bin", name)
    if not (os.path.isfile(program) and os.access(program, os.X_OK)):
        reject(f"unknown desktop helper '{name}'")
    run(program, *args)


def owned(name, args):
    run(os.path.join(PROJECT, "bin", name), *args)


def is_helper_name(name):
    """Lowercase alphanumeric words joined by single hyphens."""
    return all(word and HELPER_NAME_CHARS.issuperset(word) for word in name.split("-"))


def compat(args):
    if not args or not is_helper_name(args[0]):
        reject("compat requires an exact upstream helper suffix")
    helper, tail = args[0], args[1:]
    if helper == "hyprland-window-transparency-toggle":
        owned("terminus-transparency", tail)
    if helper == "menu" and not tail:
        owned("terminus-settings", [])
    for prefix in COMPAT_GROUP_PREFIXES:
        if helper.startswith(prefix):
            dispatch([prefix[:-1], helper[len(prefix) :], *tail])  # never returns: every route execs or exits
    if helper == "screensaver":
        owned("terminus-screensaver", tail)
    desktop("terminus-" + helper, *tail)


def menu(args):
    if args:
        desktop("terminus-menu", *args)
    owned("terminus-settings", [])


def settings(args):
    # One command: settings subcommands go to the command line, anything else opens the window.
    owned("terminus-settings", args)


def launch(args):
    if args and args[0] in LAUNCH_PROGRAMS:
        owned(LAUNCH_PROGRAMS[args[0]], args[1:])


def system(args):
    if not args or args[0] != "lock":
        return
    # A host with config/hosts/<hostname>/secure-lock (the laptop) locks for real.
    try:
        with open("/etc/hostname") as handle:
            host = handle.read().strip()
    except OSError:
        host = ""
    if host and os.path.exists(os.path.join(PROJECT, "config/hosts", host, "secure-lock")):
        owned("terminus-lock", ["force", *args[1:]])
    owned("terminus-screensaver", ["force", *args[1:]])


def branding(args):
    if args and args[0] == "screensaver":
        reject(
            "screensaver artwork is owned by config/terminus-screensaver; "
            "edit that source, not retired branding writers"
        )


def restart_hypridle():
    """Regenerate and apply only the idle configuration."""
    from pathlib import Path

    sys.path.insert(0, os.path.join(PROJECT, "lib"))
    import session
    import settings as backend

    root = Path("~/.config/terminus-est").expanduser().resolve()
    try:
        with backend.locked(root) as root_fd:
            values, _ = backend.load(root, root_fd)
            for notice in session.apply(values, root, {root / "generated/hypridle.conf"}):
                print(notice)
    except Exception as error:
        reject(str(error))


def restart(args):
    if not args:
        reject("choose bar, launcher, hypridle or swayosd; broad desktop restarts are not supported")
    if args[0] not in RESTART_UNITS and args[0] != "hypridle":
        return
    if len(args) != 1:
        reject("restart accepts exactly one component")
    if args[0] == "hypridle":
        restart_hypridle()
        raise SystemExit(0)
    run(SYSTEMCTL, "--user", "restart", RESTART_UNITS[args[0]])


def refresh(args):
    if not args or args[0] not in ("appearance", "settings"):
        reject(
            "broad config refresh is disabled: canonical files are maintained sources; "
            "use settings apply or the documented recovery procedure"
        )
    owned("terminus-settings", ["apply", *args[1:]])


def owned_route(program):
    return lambda args: owned(program, args)


# Group command -> handler(arguments). A handler either execs, exits, or returns to fall through to desktop-core.
ROUTES = {
    "compat": compat,
    "menu": menu,
    "settings": settings,
    "launch": launch,
    "system": system,
    "branding": branding,
    "restart": restart,
    "refresh": refresh,
    **{command: owned_route(program) for command, program in OWNED_PROGRAMS.items()},
}


def dispatch(args):
    if not args or args[0] in ("-h", "--help", "commands"):
        print(HELP)
        return
    command, rest = args[0], args[1:]
    handler = ROUTES.get(command)
    if handler is not None:
        handler(rest)
    desktop("desktop-core", *args)


if __name__ == "__main__":
    try:
        dispatch(sys.argv[1:])
    except OSError as error:
        print("Terminus-Est: " + str(error), file=sys.stderr)
        raise SystemExit(1) from None
