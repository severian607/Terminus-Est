# Lets members of wheel read the CPU package energy counter, which Terminus-TaskManager turns
# into CPU watts. The kernel keeps the counter root-only because precise power readings can
# leak what other programs compute (PLATYPUS); this opens it to wheel, not to everyone.
# Install: sudo install -m 644 70-terminus-cpu-energy.rules /etc/udev/rules.d/
#          sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=powercap --action=add
ACTION=="add|change", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:0", RUN+="/usr/bin/chgrp wheel /sys%p/energy_uj", RUN+="/usr/bin/chmod 0440 /sys%p/energy_uj"
