// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {"modus-themes": true, "solarized": true, "html": true, "java": true, "nvim-nightfox": true},
  "agent_servers": {
    
  },
  "proxy": "",
  "cursor_animation": {"enabled": false},
  "cursor_blink": true,
  "cli_default_open_behavior": "existing_window",
  "vim_mode": false,
  "disable_ai": false,
  "show_edit_predictions": false,
  "which_key": {
    "enabled": true,
    "delay_ms": 50
  },
  "project_panel": {
    "dock": "left",
    "default_width": 250,
    "entry_spacing": "standard",
    "indent_size": 12
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "speed": "standard",
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  // Shared mono typography for the desktop.
  "ui_font_family": "Monaspace Neon",
  "ui_font_size": 18,
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_weight": 500,
  "buffer_font_size": 15,
  "buffer_font_features": { "calt": false },
  "ui_font_features": { "calt": false },
  "buffer_line_height": { "custom": 1.65 },
  "theme": {"mode": "dark", "dark": "Terminus-Est", "light": "Modus Operandi Tinted"},
  "theme_overrides": {},
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false
  },
  "terminal": {
    "font_family": "MonaspiceNe Nerd Font",
    "font_size": 14
  },
}
