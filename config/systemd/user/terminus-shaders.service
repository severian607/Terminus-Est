[Unit]
Description=Standalone screen shader picker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=local.terminus.Shaders
ExecStart=/usr/bin/python3 %h/Projects/Terminus-Est/lib/shader_panel.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
