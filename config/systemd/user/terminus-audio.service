# Preloaded picker panel: bin/terminus-audio only activates this D-Bus service, so the key press starts no Python or GTK.
[Unit]
Description=Standalone audio effects picker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=local.terminus.Audio
ExecStart=/usr/bin/python3 %h/Projects/Terminus-Est/lib/shader_panel.py audio
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
