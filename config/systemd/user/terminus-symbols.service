[Unit]
Description=Standalone one-key Unicode symbol panel
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=local.terminus.Symbols
ExecStart=/usr/bin/python3 %h/Projects/Terminus-Est/lib/symbol_panel.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
