#!/usr/bin/env python3
# Wait for native IPC independently of which monitors are connected.
import subprocess
import sys
import time
from pathlib import Path

BINARY = Path(__file__).resolve().parents[1] / "bin/terminus-bar"
READY_TIMEOUT_S = 10
ATTEMPT_TIMEOUT_MAX_S = 1
ATTEMPT_TIMEOUT_MIN_S = 0.1
POLL_INTERVAL_S = 0.1

deadline = time.monotonic() + READY_TIMEOUT_S
while time.monotonic() < deadline:
    attempt_timeout = min(ATTEMPT_TIMEOUT_MAX_S, max(ATTEMPT_TIMEOUT_MIN_S, deadline - time.monotonic()))
    try:
        if subprocess.run([str(BINARY), "msg", "status"], capture_output=True, timeout=attempt_timeout).returncode == 0:
            sys.exit(0)
    except subprocess.TimeoutExpired:
        pass  # the bar is up but not answering yet; poll again
    time.sleep(POLL_INTERVAL_S)
sys.exit(f"Terminus-Bar IPC did not become ready within {READY_TIMEOUT_S} seconds")
