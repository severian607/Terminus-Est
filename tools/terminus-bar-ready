#!/usr/bin/env python3
# Wait for native IPC independently of which monitors are connected.
from pathlib import Path
import subprocess
import sys
import time

binary = Path(__file__).resolve().parents[1] / 'bin/terminus-bar'
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
    try:
        result = subprocess.run([str(binary), 'msg', 'status'],
                                capture_output=True, timeout=min(1, max(.1, deadline - time.monotonic())))
        if result.returncode == 0:
            sys.exit(0)
    except subprocess.TimeoutExpired:
        pass
    time.sleep(.1)
sys.exit('Terminus-Bar IPC did not become ready within 10 seconds')
