#!/usr/bin/python3 -I
"""Authenticated cosmetic-only Ly apply; never starts or changes a service."""

import argparse
import contextlib
import fcntl
import json
import math
import os
import re
import secrets
import select
import stat
import sys
import time
from pathlib import Path

# Untrusted request validation

FIELDS = {
    "animation",
    "password_style",
    "animation_frame_delay",
    "animation_timeout_sec",
    "background",
    "foreground",
    "accent",
    "show_borders",
    "show_clock",
}
TARGET = "/etc/ly/config.ini"
LIMIT = 16384
MAX_REQUEST_SECONDS = 110
LOCK_SECONDS = 10
# Set before the replace syscall: failure/interruption after this point cannot
# establish a no-write outcome merely from the helper's exit code.
PUBLICATION_ATTEMPTED = False


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"Duplicate payload key: {key}")
        result[key] = value
    return result


def validate(raw):
    if len(raw.encode("utf-8")) > LIMIT:
        raise ValueError("Appearance payload is too large")
    values = json.loads(raw, object_pairs_hook=unique_object)
    if type(values) is not dict or set(values) != FIELDS:
        raise ValueError("Payload must contain exactly the approved login appearance fields")
    if type(values["animation"]) is not str or values["animation"] not in (
        "none",
        "doom",
        "matrix",
        "colormix",
        "gameoflife",
        "dur_file",
        "terminus",
    ):
        raise ValueError("Invalid animation")
    if type(values["password_style"]) is not str or values["password_style"] not in ("asterisk", "constellation"):
        raise ValueError("Invalid password_style")
    for key, low, high in (("animation_frame_delay", 10, 1000), ("animation_timeout_sec", 0, 3600)):
        if type(values[key]) is not int or not low <= values[key] <= high:
            raise ValueError(f"{key} must be an integer in {low}..{high}")
    for key in ("background", "foreground", "accent"):
        if type(values[key]) is not str or not re.fullmatch(r"#[0-9a-fA-F]{6}", values[key]):
            raise ValueError(f"Invalid {key}; expected #RRGGBB")
    for key in ("show_borders", "show_clock"):
        if type(values[key]) is not bool:
            raise ValueError(f"{key} must be boolean")

    def color(key, bold=False):
        rgb = values[key][1:].upper()
        # Ly reserves zero for terminal default; explicit black needs TB_HI_BLACK.
        style = (1 if bold else 0) | (0x20 if rgb == "000000" else 0)
        return f"0x{style:02X}{rgb}"

    return {
        "animation": values["animation"],
        "password_style": values["password_style"],
        "animation_frame_delay": str(values["animation_frame_delay"]),
        "animation_timeout_sec": str(values["animation_timeout_sec"]),
        "bg": color("background"),
        "fg": color("foreground"),
        "border_fg": color("accent"),
        "error_fg": color("accent", bold=True),
        "cmatrix_fg": color("accent"),
        "hide_borders": "false" if values["show_borders"] else "true",
        "clock": "%H:%M" if values["show_clock"] else "null",
    }


class Request:
    """Finite authenticated request with pidfd-pinned, non-root lifetime owners."""

    def __init__(self, raw):
        if raw is None or len(raw.encode("utf-8")) > 4096:
            raise ValueError("A bounded request lifetime is required")
        values = json.loads(raw, object_pairs_hook=unique_object)
        if type(values) is not dict or set(values) != {"version", "issued", "deadline", "owners"}:
            raise ValueError("Unexpected request lifetime fields")
        if type(values["version"]) is not int or values["version"] != 1:
            raise ValueError("Unsupported request lifetime version")
        issued, deadline = values["issued"], values["deadline"]
        if any(
            type(value) not in (int, float) or (type(value) is float and not math.isfinite(value))
            for value in (issued, deadline)
        ):
            raise ValueError("Request timestamps must be finite monotonic numbers")
        now = time.monotonic()
        if (
            not 0 <= issued <= now
            or not now < deadline <= now + MAX_REQUEST_SECONDS
            or not 0 < deadline - issued <= MAX_REQUEST_SECONDS
        ):
            raise ValueError("Request has expired or has an invalid lifetime")
        owners = values["owners"]
        if type(owners) is not list or not 1 <= len(owners) <= 2:
            raise ValueError("Request must bind its client and optional backend")
        self.deadline = deadline
        self.owners = []
        self.descriptors = []
        try:
            for owner in owners:
                if type(owner) is not dict or set(owner) != {"pid", "start", "uid"}:
                    raise ValueError("Unexpected request owner fields")
                if (
                    type(owner["pid"]) is not int
                    or not 0 < owner["pid"] <= 2147483647
                    or type(owner["uid"]) is not int
                    or not 0 < owner["uid"] < 4294967295
                    or type(owner["start"]) is not str
                    or not re.fullmatch(r"[1-9][0-9]{0,19}", owner["start"])
                ):
                    raise ValueError("Invalid request owner identity")
                if self.owners and (owner["uid"] != self.owners[0]["uid"] or owner["pid"] == self.owners[0]["pid"]):
                    raise ValueError("Request owners must be distinct processes of the same desktop user")
                # pkexec supplies this value itself; run0 need not export it.
                authenticated_uid = os.environ.get("PKEXEC_UID")
                if authenticated_uid is not None and authenticated_uid != str(owner["uid"]):
                    raise ValueError("Request owner differs from the authenticated desktop user")
                self.descriptors.append(os.pidfd_open(owner["pid"]))
                self.owners.append(owner)
            self.check()
        except BaseException:
            self.close()
            raise

    def check(self):
        if time.monotonic() >= self.deadline:
            raise ValueError("Request expired; no late appearance publication is permitted")
        for descriptor, owner in zip(self.descriptors, self.owners):
            if select.select([descriptor], [], [], 0)[0]:
                raise ValueError("Request owner exited; appearance publication cancelled")
            process = Path("/proc") / str(owner["pid"])
            try:
                fields = (process / "stat").read_text().rsplit(")", 1)[1].split()
                status = dict(line.split(":", 1) for line in (process / "status").read_text().splitlines())
                valid = (
                    fields[19] == owner["start"]
                    and fields[0] not in ("Z", "X", "x")
                    and all(int(uid) == owner["uid"] for uid in status["Uid"].split())
                )
            except (IndexError, KeyError) as error:
                raise ValueError("Cannot establish request owner identity") from error
            if not valid or select.select([descriptor], [], [], 0)[0]:
                raise ValueError("Request owner identity changed; appearance publication cancelled")
        if time.monotonic() >= self.deadline:
            raise ValueError("Request expired; no late appearance publication is permitted")

    def acquire(self, descriptor):
        deadline = min(self.deadline, time.monotonic() + LOCK_SECONDS)
        while True:
            self.check()
            if time.monotonic() >= deadline:
                raise ValueError("Login appearance lock wait expired")
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.check()
                return
            except BlockingIOError:
                # Owner exit wakes the wait immediately; expiry is checked at
                # least every 50 ms even when the lock holder never releases it.
                select.select(self.descriptors, [], [], max(0, min(0.05, deadline - time.monotonic())))

    def close(self):
        for descriptor in self.descriptors:
            os.close(descriptor)
        self.descriptors.clear()


# Lossless allowlisted INI patching


def patch(original, values):
    text = original.decode("utf-8")
    if "\x00" in text:
        raise ValueError("NUL in existing Ly configuration")
    lines = text.splitlines(keepends=True)
    seen = set()
    section = False
    insertion = len(lines)
    for index, line in enumerate(lines):
        if line.lstrip().startswith("["):
            if not section:
                insertion = index
            section = True
        match = re.fullmatch(r"([ \t]*)([A-Za-z_][A-Za-z0-9_]*)([ \t]*=[ \t]*)([^\r\n]*)(\r?\n)?", line)
        if not match or section or match[2] not in values:
            continue
        key = match[2]
        if key in seen:
            raise ValueError(f"Duplicate existing cosmetic key: {key}")
        seen.add(key)
        # Keep trailing inline comments and whitespace, including original line endings.
        suffix_match = re.search(r"([ \t]+[;#].*|[ \t]*)$", match[4])
        suffix = suffix_match[0] if suffix_match else ""
        lines[index] = match[1] + key + match[3] + values[key] + suffix + (match[5] or "")
    missing = [key for key in values if key not in seen]
    if missing:
        newline = "\r\n" if "\r\n" in text else "\n"
        additions = [f"{key} = {values[key]}{newline}" for key in missing]
        if insertion and not lines[insertion - 1].endswith(("\n", "\r")):
            additions.insert(0, newline)
        lines[insertion:insertion] = additions
    return "".join(lines).encode("utf-8")


def read_regular(fd):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size > 1024 * 1024:
        raise ValueError("Ly configuration must be a regular file under 1 MiB")
    with os.fdopen(os.dup(fd), "rb") as source:
        content = source.read(1024 * 1024 + 1)
    if len(content) > 1024 * 1024:
        raise ValueError("Ly configuration is too large")
    return info, content


def trusted_directory(path):
    current = Path("/")
    for part in Path(path).parts[1:]:
        current /= part
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError(f"Untrusted root directory: {current}")
    return os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)


def write_all(fd, content):
    view = memoryview(content)
    while view:
        count = os.write(fd, view)
        if count <= 0:
            raise OSError("Short write")
        view = view[count:]


# Root-only atomic commit with a trusted original backup


def commit(values, request):
    global PUBLICATION_ATTEMPTED
    request.check()
    directory = trusted_directory("/etc/ly")
    temporary = None
    lock = source = backup_dir = None
    try:
        lock = os.open(".terminus-appearance.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        lock_info = os.fstat(lock)
        if (
            not stat.S_ISREG(lock_info.st_mode)
            or lock_info.st_uid != 0
            or lock_info.st_nlink != 1
            or lock_info.st_mode & 0o077
        ):
            raise ValueError("Untrusted login appearance lock")
        request.acquire(lock)
        source = os.open("config.ini", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
        info, original = read_regular(source)
        if info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o022:
            raise ValueError("Ly configuration must be root-owned and not group/world writable or hardlinked")
        updated = patch(original, values)
        if updated == original:
            request.check()
            return {
                "status": "unchanged",
                "message": "Login appearance already matches; configuration unchanged and Ly was not restarted.",
            }
        backup_name = ".terminus-appearance-backups"
        with contextlib.suppress(FileExistsError):
            os.mkdir(backup_name, mode=0o700, dir_fd=directory)
        backup_dir = os.open(backup_name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
        backup_info = os.fstat(backup_dir)
        if backup_info.st_uid != 0 or backup_info.st_mode & 0o077:
            raise ValueError("Untrusted login backup directory")
        name = time.strftime("config.ini.%Y%m%dT%H%M%S") + "." + secrets.token_hex(8)
        backup = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=backup_dir)
        try:
            write_all(backup, original)
            os.fsync(backup)
        finally:
            os.close(backup)
        os.fsync(backup_dir)
        temporary = ".terminus-appearance." + secrets.token_hex(16)
        target = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            write_all(target, updated)
            os.fchown(target, info.st_uid, info.st_gid)
            os.fchmod(target, stat.S_IMODE(info.st_mode))
            os.fsync(target)
        finally:
            os.close(target)
        current = os.stat("config.ini", dir_fd=directory, follow_symlinks=False)
        if (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns, current.st_ctime_ns) != (
            info.st_dev,
            info.st_ino,
            info.st_size,
            info.st_mtime_ns,
            info.st_ctime_ns,
        ):
            raise ValueError("Ly configuration changed concurrently; refusing to replace it")
        request.check()
        PUBLICATION_ATTEMPTED = True
        os.replace(temporary, "config.ini", src_dir_fd=directory, dst_dir_fd=directory)
        temporary = None
        os.fsync(directory)
        return {
            "status": "applied",
            "backup": "/etc/ly/" + backup_name + "/" + name,
            "message": "Login appearance saved; effective at the next Ly start. "
            "Ly and the current session were not restarted.",
        }
    finally:
        if temporary:
            os.unlink(temporary, dir_fd=directory)
        for fd in (source, lock, backup_dir, directory):
            if fd is not None:
                os.close(fd)


# Noncommitting verification is deliberately unavailable to root


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--payload", required=True, help="JSON appearance object, never an INI or executable")
    parser.add_argument("--request", help="Separate finite-expiry and pinned process-owner JSON")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--check", action="store_true")
    parser.add_argument("--config", help="Caller-selected temporary INI; non-root verification only")
    args = parser.parse_args()
    values = validate(args.payload)
    verification = args.dry_run or args.check
    if os.geteuid() == 0:
        if verification or args.config is not None:
            raise ValueError("Root apply accepts no destination or verification override; target is fixed at " + TARGET)
        request = Request(args.request)
        try:
            result = commit(values, request)
        finally:
            request.close()
    else:
        if args.request is not None:
            raise ValueError("Verification accepts cosmetics only, not authenticated request metadata")
        if not verification or not args.config:
            raise PermissionError(
                "Apply requires explicit authenticated elevation; "
                "non-root use requires --check/--dry-run --config TEMP_INI"
            )
        selected = Path(args.config).absolute()
        if selected.resolve() == Path(TARGET):
            raise ValueError("Verification requires a caller-selected temporary INI, not the live Ly configuration")
        fd = os.open(selected, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            info, original = read_regular(fd)
            if info.st_uid != os.getuid():
                raise ValueError("Verification INI must belong to the calling user")
            updated = patch(original, values)
        finally:
            os.close(fd)
        result = {
            "status": "would-change" if updated != original else "unchanged",
            "written": False,
            "allowed_ini_keys": list(values),
            "message": "Verification only; no files written.",
        }
        if args.dry_run:
            result["preview"] = updated.decode("utf-8")
    print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, UnicodeError) as error:
        print(
            json.dumps(
                {
                    "status": "unknown" if PUBLICATION_ATTEMPTED else "refused",
                    "written": None if PUBLICATION_ATTEMPTED else False,
                    "message": str(error),
                },
                sort_keys=True,
            )
        )
        print("Login appearance refused: " + str(error), file=sys.stderr)
        sys.exit(1)
