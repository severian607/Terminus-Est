#!/usr/bin/env python3
# Bring a machine in line with the laptop's light/dark setup. Run after `git pull`; safe to run twice.
#
# Applies what lives outside this repository: Zed (dark/light themes, Modus extension, font weight, Catppuccin
# syntax colours for the dark theme), the Obsidian light palette, the Ghostty light include and the Skwd scheme
# check. Everything it rewrites is copied first to ~/Backups/<D.M.YY>/light-mode-install/.
# The Super+Ctrl+L binding, the toggle script, the bar palette and the Strata skin come with the repository.
import datetime
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
ROOT = Path(__file__).resolve().parents[1]
BACKUP = HOME / "Backups" / datetime.date.today().strftime("%-d.%-m.%y") / "light-mode-install"
ZED_SETTINGS = HOME / ".config/zed/settings.json"
ZED_EXTENSIONS = ("solarized", "modus-themes")
LIGHT_THEME = "Modus Operandi Tinted"
OBSIDIAN_LIGHT_BG = "#fbf7f0"
STEP_LABEL_WIDTH = 9


def backup(path: Path) -> None:
    target = BACKUP / str(path).lstrip("/")
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        shutil.copy2(path, target)


def say(step: str, message: str) -> None:
    print(f"{step:<{STEP_LABEL_WIDTH}} {message}")


def with_theme_pair(text: str) -> tuple[str, str | None] | None:
    """Turn a single "theme" string into a dark/light pair; returns (text, dark theme name), None if no theme."""
    single = re.search(r'"theme":\s*"([^"]+)"', text)
    if single:
        dark = single.group(1)
        pair = f'"theme": {{"mode": "dark", "dark": "{dark}", "light": "{LIGHT_THEME}"}}'
        return text.replace(single.group(0), pair, 1), dark
    if not re.search(r'"theme":\s*\{', text):
        return None
    existing = re.search(r'"theme":\s*\{[^}]*"dark":\s*"([^"]+)"', text)
    return text, existing.group(1) if existing else None


def with_auto_install(text: str) -> str:
    """Make sure Zed installs the Modus and Solarized themes on its next start."""
    block = re.search(r'"auto_install_extensions":\s*\{([^}]*)\}', text)
    if not block:
        return text.replace("{", '{\n  "auto_install_extensions": {"modus-themes": true, "solarized": true},', 1)
    body = block.group(1)
    for name in ZED_EXTENSIONS:
        if f'"{name}"' not in body:
            separator = "," if body.strip() and not body.rstrip().endswith(",") else ""
            body = f'{body.rstrip()}{separator}\n    "{name}": true'
    if body == block.group(1):
        return text
    return text.replace(block.group(0), f'"auto_install_extensions": {{{body.rstrip()}\n  }}', 1)


def zed_dark_syntax(dark: str | None) -> None:
    """Catppuccin Mocha syntax colours for the dark theme file, when it is a plain local file."""
    syntax = json.loads((ROOT / "config/light-mode/zed-dark-syntax.json").read_text())
    for theme_file in (HOME / ".config/zed/themes").glob("*.json"):
        if theme_file.is_symlink():
            continue
        data = json.loads(theme_file.read_text())
        for theme in data.get("themes", []):
            if theme.get("name") != dark or theme.get("appearance") != "dark":
                continue
            if theme["style"].get("syntax") == syntax:
                say("zed", "dark syntax colours already set")
                return
            backup(theme_file)
            theme["style"]["syntax"] = syntax
            theme_file.write_text(json.dumps(data, indent=2) + "\n")
            say("zed", f'dark theme "{dark}": Catppuccin Mocha syntax colours')
            return
    say("zed", f'dark theme "{dark}" is not a local theme file; its syntax colours were left alone')


def zed() -> None:
    if not ZED_SETTINGS.is_file():
        say("zed", "no settings.json, skipped")
        return
    original = ZED_SETTINGS.read_text()
    themed = with_theme_pair(original)
    if themed is None:
        say("zed", "theme setting not recognised, skipped")
        return
    text, dark = themed
    text = re.sub(r'"buffer_font_weight":\s*\d+', '"buffer_font_weight": 500', text, count=1)
    text = with_auto_install(text)
    if text != original:
        backup(ZED_SETTINGS)
        ZED_SETTINGS.write_text(text)
        say("zed", "settings: dark/light themes, weight 500, Modus + Solarized extensions (install on next Zed start)")
    else:
        say("zed", "settings already set")
    zed_dark_syntax(dark)


OBSIDIAN_LIGHT = {
    "#f8f8f8": "#fbf7f0",
    "#f0efea": "#efe9dd",
    "rgb(31 31 29 / 0.04)": "rgb(0 0 0 / 0.04)",
    "#e7e7e2": "#efe9dd",
    "--ep-text: #1f1f1d": "--ep-text: #000000",
    "--ep-text-bright: #0f0f0e": "--ep-text-bright: #000000",
    "#66655f": "#595959",
    "--ep-text-faint: #bdbbb3": "--ep-text-faint: #c4bab1",
    "--ep-accent: #5b3cc4": "--ep-accent: #0031a9",
    "91 60 196": "0 49 169",
    "91, 60, 196": "0, 49, 169",
    "#7a5fd0": "#193668",
    "rgb(226 180 60 / 0.38)": "rgb(240 220 150 / 0.55)",
    "--ep-border: #dcdbd5": "--ep-border: #d0c6bc",
    "--ep-border-strong: #bdbbb3": "--ep-border-strong: #9f9690",
    "rgb(31 31 29 / 0.06)": "rgb(0 0 0 / 0.06)",
}


def obsidian() -> None:
    try:
        vaults = json.loads((HOME / ".config/obsidian/obsidian.json").read_text())["vaults"].values()
    except (OSError, ValueError, KeyError):
        say("obsidian", "no Obsidian config, skipped")
        return
    done = False
    for vault in vaults:
        vault_path = Path(vault["path"])
        css = vault_path / ".obsidian/snippets/editor-polish.css"
        if not css.is_file():
            continue
        text = css.read_text()
        start = text.find("body.theme-light {\n  --ep-bg:")
        end = text.find("/* Inter when installed", start)
        if start < 0 or end < 0:
            say("obsidian", f"{css}: light block not found, skipped")
            continue
        block = text[start:end]
        done = True
        if OBSIDIAN_LIGHT_BG in block:
            say("obsidian", f"{vault_path.name}: already Modus light")
            continue
        for old, new in OBSIDIAN_LIGHT.items():
            block = block.replace(old, new)
        text = text[:start] + block + text[end:]
        for state in ("active", "selected"):
            text = text.replace(
                f"--nav-item-background-{state}: #fbfbfa;", f"--nav-item-background-{state}: {OBSIDIAN_LIGHT_BG};"
            )
        backup(css)
        css.write_text(text)
        say("obsidian", f"{vault_path.name}: light palette is Modus Operandi Tinted")
    if not done:
        say("obsidian", "no vault with editor-polish.css, skipped")


def ghostty() -> None:
    config = HOME / ".config/ghostty/config"
    include = 'config-file = ?"~/.config/terminus-est/generated/ghostty-mode.conf"'
    mode = HOME / ".config/terminus-est/generated/ghostty-mode.conf"
    mode.parent.mkdir(parents=True, exist_ok=True)
    if not mode.exists():
        mode.write_text("# Written by terminus-theme-toggle; empty in dark mode.\n")
    if not config.is_file():
        say("ghostty", "no Ghostty config, skipped")
        return
    text = config.read_text()
    if include in text:
        say("ghostty", "include already present")
        return
    backup(config)
    comment = "# Light mode colours, written by terminus-theme-toggle (last include wins)"
    config.write_text(f"{text.rstrip('\n')}\n\n{comment}\n{include}\n")
    say("ghostty", "light-mode include added")


def wallpapers() -> None:
    folder = HOME / "Pictures/Wallpapers/Light mode"
    count = len([p for p in folder.glob("*") if p.is_file()]) if folder.is_dir() else 0
    if count:
        say("wallpaper", f'{count} wallpapers in "Light mode"')
    else:
        say("wallpaper", f'NO "Light mode" wallpapers at {folder}; light mode will keep the current wallpaper')


def palette() -> None:
    script = ROOT / "tools/terminus-skwd-palette"
    if not (HOME / ".cache/skwd-wall-v2/scheme.json").is_file():
        say("palette", "no Skwd scheme yet; the palette is built on the next wallpaper change")
        return
    result = subprocess.run([sys.executable, str(script)], capture_output=True, text=True)
    say(
        "palette",
        "bar palette regenerated" if result.returncode == 0 else f"palette sync failed: {result.stderr.strip()}",
    )


if __name__ == "__main__":
    for step in (zed, obsidian, ghostty, wallpapers, palette):
        try:
            step()
        except (OSError, ValueError, KeyError) as error:
            say(step.__name__, f"failed: {error!r}")
    print(f"\nBackups: {BACKUP}\nRestart Zed once so it installs the Modus extension. Toggle with Super+Ctrl+L.")
