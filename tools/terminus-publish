#!/usr/bin/env python3
"""Publish a snapshot of this (private) repository's committed main to the public repository.

    terminus-publish            build, check, commit on top of the public main and push
    terminus-publish --dry-run  build and check only; prints the staging tree to inspect

tools/publish/include.txt picks what goes public, exclude.txt takes paths back out, and forbidden.txt holds
regexes that must not appear in any published file. The public history is a line of snapshots authored by the
noreply identity; private history never leaves this repository.
"""

import fnmatch
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RULES = ROOT / "tools/publish"
PUBLIC = os.environ.get("TERMINUS_PUBLIC_URL", "https://github.com/severian607/Terminus-Est.git")
IDENTITY = {
    "GIT_AUTHOR_NAME": "Severian",
    "GIT_AUTHOR_EMAIL": "292257091+severian607@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "Severian",
    "GIT_COMMITTER_EMAIL": "292257091+severian607@users.noreply.github.com",
}


def git(*args: str, cwd: Path = ROOT, env: dict | None = None) -> str:
    return subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True, text=True,
                          env={**os.environ, **(env or {})}).stdout


def rules(name: str) -> list[str]:
    lines = (RULES / name).read_text().splitlines()
    return [line for line in lines if line.strip() and not line.startswith("#")]


def matches(path: str, patterns: list[str]) -> bool:
    return any(path.startswith(p) if p.endswith("/") else fnmatch.fnmatchcase(path, p) for p in patterns)


def build(stage: Path) -> list[str]:
    """Extract the published files of HEAD into stage; return their paths."""
    include, exclude = rules("include.txt"), rules("exclude.txt")
    paths = [p for p in git("ls-tree", "-r", "-z", "--name-only", "HEAD").split("\0")
             if p and matches(p, include) and not matches(p, exclude)]
    archive = subprocess.run(["git", "archive", "--format=tar", "HEAD", "--", *paths], cwd=ROOT,
                             check=True, capture_output=True).stdout
    subprocess.run(["tar", "-x", "-C", str(stage)], input=archive, check=True)
    return paths


def leaks(stage: Path, paths: list[str]) -> list[str]:
    forbidden = re.compile("|".join(f"(?:{p})" for p in rules("forbidden.txt")).encode())
    found = []
    for path in paths:
        if forbidden.search(path.encode()):
            found.append(f"{path}: name")
        file = stage / path
        if file.is_symlink():
            # A link's target is published as its content: it must stay inside the repository.
            target = os.readlink(file)
            resolved = os.path.normpath(os.path.join(os.path.dirname(path), target))
            if target.startswith("/") or resolved.startswith("..") or forbidden.search(target.encode()):
                found.append(f"{path}: symlink to {target}")
            continue
        if not file.is_file():
            continue
        for match in forbidden.finditer(file.read_bytes()):
            found.append(f"{path}: {match.group().decode(errors='replace')}")
    return found


def publish(work: Path, dry: bool) -> int:
    stage = work / "stage"
    stage.mkdir()
    paths = build(stage)
    found = leaks(stage, paths)
    if found:
        print("terminus-publish: forbidden strings in the snapshot; nothing pushed:", *found, sep="\n  ", file=sys.stderr)
        return 1
    head = git("rev-parse", "--short", "HEAD").strip()
    print(f"terminus-publish: {len(paths)} files from {head}, no forbidden strings")
    if dry:
        print(f"terminus-publish: dry run; snapshot in {stage}")
        return 0

    repo = work / "public"
    subprocess.run(["git", "clone", "--quiet", PUBLIC, str(repo)], check=True)
    fresh = subprocess.run(["git", "rev-parse", "--verify", "--quiet", "HEAD"], cwd=repo,
                           capture_output=True).returncode != 0
    git("checkout", "--quiet", "-B", "main", cwd=repo)
    for entry in repo.iterdir():
        if entry.name != ".git":
            shutil.rmtree(entry) if entry.is_dir() and not entry.is_symlink() else entry.unlink()
    shutil.copytree(stage, repo, symlinks=True, dirs_exist_ok=True)
    git("add", "--all", cwd=repo)
    if not git("status", "--porcelain", cwd=repo).strip():
        print("terminus-publish: public repository already matches; nothing pushed")
        return 0
    message = "Terminus-Est" if fresh else "Update Terminus-Est"
    git("commit", "--quiet", "-m", message, cwd=repo, env=IDENTITY)
    subprocess.run(["git", "push", "--quiet", "origin", "main"], cwd=repo, check=True)
    print(f"terminus-publish: pushed {git('rev-parse', '--short', 'HEAD', cwd=repo).strip()} to {PUBLIC}")
    return 0


def main() -> int:
    dry = sys.argv[1:] == ["--dry-run"]
    work = Path(tempfile.mkdtemp(prefix="terminus-publish."))
    try:
        return publish(work, dry)
    finally:
        if not dry:  # a dry run leaves the staging tree for inspection
            shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
