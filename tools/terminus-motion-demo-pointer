#!/bin/bash

# Moves the pointer inside a terminus-motion-sandbox along a lively path for about 3.3 seconds: a looping curve,
# a fast sweep, a glide back to the middle and a shake. Used to record previews of the pointer motion entries.
# The path runs as a compositor-side timer (8 ms steps), so its speed does not depend on process start times.
# dynamic-cursors ignores warps by default and dispatcher moves are warps, so the script turns that off first
# (until the next config reload). Returns when the path has ended. Assumes the 960x540 sandbox output.

set -euo pipefail

if (( $# != 1 )) || [[ ! $1 =~ ^[a-z0-9]{1,8}$ ]]; then
  echo "usage: terminus-motion-demo-pointer NAME" >&2
  exit 2
fi

sandbox="$(dirname "$(readlink -f "$0")")/terminus-motion-sandbox"

path=$(cat <<'LUA'
if hl.plugin.dynamic_cursors then
  hl.config({ plugin = { dynamic_cursors = { ignore_warps = false } } })
end
local step, dt = 0, 0.008
local timer
local function ease(u) return u * u * (3 - 2 * u) end
local function lerp(a, b, u) return a + (b - a) * u end
timer = hl.timer(function()
  step = step + 1
  local s = step * dt
  local x, y
  if s < 1.3 then
    local u = s / 1.3
    x, y = 480 + 300 * math.sin(2 * math.pi * u), 270 + 130 * math.sin(4 * math.pi * u)
  elseif s < 1.5 then
    local u = ease((s - 1.3) / 0.2)
    x, y = lerp(480, 80, u), lerp(270, 400, u)
  elseif s < 1.8 then
    local u = ease((s - 1.5) / 0.3)
    x, y = lerp(80, 880, u), lerp(400, 140, u)
  elseif s < 2.1 then
    local u = ease((s - 1.8) / 0.3)
    x, y = lerp(880, 480, u), lerp(140, 270, u)
  elseif s < 3.2 then
    local k = s - 2.1
    local amp = math.min(1, k / 0.15)
    x, y = 480 + 120 * amp * math.sin(2 * math.pi * 7 * k), 270 + 40 * amp * math.sin(2 * math.pi * 5.3 * k)
  else
    timer:set_enabled(false)
    return
  end
  hl.dispatch(hl.dsp.cursor.move({ x = math.floor(x + 0.5), y = math.floor(y + 0.5) }))
end, { timeout = 8, type = "repeat" })
LUA
)

"$sandbox" ctl "$1" eval "$path" >/dev/null
sleep 3.5
