#!/usr/bin/env python3
"""Vitals logger: one row per minute of cpu / gpu / memory, the top ten apps per kind, and events.

Runs as terminus-vitals-log.service. Every SUB seconds it samples; once a minute it writes the minute's
min / avg / max. Data lives in ~/.local/state/terminus-est/vitals.sqlite for RETENTION_DAYS days.
The vitals panel reads it through `vitals-query`.
"""
import glob
import os
import sqlite3
import subprocess
import sys
import time

DB = os.path.expanduser("~/.local/state/terminus-est/vitals.sqlite")
SUB = 15                 # seconds between samples
PER_ROW = 4              # samples per stored minute
RETENTION_DAYS = 8
TOP = 10
HOT_CPU, HOT_GPU = 90.0, 95.0
CLK = os.sysconf("SC_CLK_TCK")

# Browser helper processes count as the browser they belong to.
APP_OF = {n: "firefox" for n in (
    "Isolated Web Co", "Web Content", "WebExtensions", "RDD Process", "Privileged Cont", "Socket Process",
    "Utility Process", "GPU Process", "Isolated Servic", "firefox-bin", "Forked Web Proce")}


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def num(text):
    try:
        return float(text.strip().split()[0])
    except (ValueError, IndexError):
        return None


def cpu_times():
    f = read("/proc/stat").split("\n", 1)[0].split()[1:]
    vals = [int(x) for x in f]
    return sum(vals), vals[3] + (vals[4] if len(vals) > 4 else 0)


def hwmon(name):
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(d + "/name").strip() == name:
            return d
    return None


def cpu_temp():
    for name in ("k10temp", "coretemp", "zenpower"):
        d = hwmon(name)
        if d:
            for f in ("temp1_input", "temp2_input"):
                v = num(read(f"{d}/{f}"))
                if v:
                    return v / 1000
    return None


def gpu_dir():
    for d in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        if os.path.exists(d + "/gpu_busy_percent"):
            return d
    return None


GPU = gpu_dir()


def gpu_sample():
    if not GPU:
        return None, None, None, None
    busy = num(read(GPU + "/gpu_busy_percent"))
    temp = watts = None
    for h in glob.glob(GPU + "/hwmon/hwmon*"):
        t = num(read(h + "/temp1_input"))
        temp = t / 1000 if t else temp
        w = num(read(h + "/power1_average")) or num(read(h + "/power1_input"))
        watts = w / 1e6 if w else watts
    used = num(read(GPU + "/mem_info_vram_used"))
    total = num(read(GPU + "/mem_info_vram_total"))
    vram = used / total * 100 if used is not None and total else None
    return busy, temp, watts, vram


def meminfo():
    kb = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        kb[k] = int(v.split()[0])
    total = kb.get("MemTotal", 1)
    used = (total - kb.get("MemAvailable", 0)) / total * 100
    swap_total = kb.get("SwapTotal", 0)
    swap = (swap_total - kb.get("SwapFree", 0)) / swap_total * 100 if swap_total else 0.0
    return used, swap


def app_name(comm):
    return APP_OF.get(comm, comm)


def pss_bytes(pid):
    """Proportional set size: shared pages are split between the processes sharing them, so summing over an
    app's processes gives its true total. None when the process is not ours to read."""
    try:
        with open(f"/proc/{pid}/smaps_rollup") as f:
            for line in f:
                if line.startswith("Pss:"):
                    return int(line.split()[1]) * 1024
    except OSError:
        pass
    return None


def proc_scan(with_pss=False):
    """{pid: (app, cpu_ticks, memory_bytes)}; memory is PSS when asked and readable, else resident size."""
    out = {}
    page = os.sysconf("SC_PAGE_SIZE")
    for p in glob.glob("/proc/[0-9]*"):
        try:
            stat = read(p + "/stat")
            r = stat.rindex(")")
            comm = stat[stat.index("(") + 1:r]
            f = stat[r + 2:].split()
            ticks = int(f[11]) + int(f[12])
            rss = int(f[21]) * page
            if with_pss:
                rss = pss_bytes(p[6:]) or rss
            out[int(p[6:])] = (app_name(comm), ticks, rss)
        except (OSError, ValueError, IndexError):
            continue
    return out


def gpu_procs():
    """{app: vram bytes} from DRM fdinfo, each client counted once."""
    seen, totals = set(), {}
    for p in glob.glob("/proc/[0-9]*/fdinfo/*"):
        text = read(p)
        if "drm-client-id" not in text:
            continue
        pid = p.split("/")[2]
        cid, mem = None, 0
        for line in text.splitlines():
            k, _, v = line.partition(":")
            if k == "drm-client-id":
                cid = v.strip()
            elif k in ("drm-resident-vram", "drm-resident-gtt"):
                n = num(v) or 0
                u = v.split()[1] if len(v.split()) > 1 else ""
                mem += n * {"KiB": 1024, "MiB": 1048576, "GiB": 1073741824}.get(u, 1)
        if (pid, cid) in seen or not mem:
            continue
        seen.add((pid, cid))
        app = app_name(read(f"/proc/{pid}/comm").strip())
        totals[app] = totals.get(app, 0) + mem
    return totals


def connect():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB)
    db.executescript("""
    CREATE TABLE IF NOT EXISTS samples(ts INTEGER PRIMARY KEY,
      cpu_min REAL, cpu_avg REAL, cpu_max REAL, cpu_t REAL,
      gpu_min REAL, gpu_avg REAL, gpu_max REAL, gpu_t REAL, gpu_w REAL,
      mem_min REAL, mem_avg REAL, mem_max REAL, swap REAL);
    CREATE TABLE IF NOT EXISTS procs(ts INTEGER, kind TEXT, app TEXT, value REAL);
    CREATE INDEX IF NOT EXISTS procs_ts ON procs(ts, kind);
    CREATE TABLE IF NOT EXISTS events(ts INTEGER, kind TEXT, detail TEXT);
    CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
    """)
    return db


def meta(db, k, v=None):
    if v is None:
        row = db.execute("SELECT v FROM meta WHERE k=?", (k,)).fetchone()
        return row[0] if row else None
    db.execute("INSERT OR REPLACE INTO meta VALUES(?,?)", (k, v))


def stats(vals):
    vals = [v for v in vals if v is not None]
    return (min(vals), sum(vals) / len(vals), max(vals)) if vals else (None, None, None)


def oom_events(db, since):
    try:
        out = subprocess.run(
            ["journalctl", "-k", "--no-pager", "-o", "short-unix", f"--since=@{int(since)}",
             "-g", "Out of memory|oom-kill"], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return
    for line in out.splitlines():
        ts, _, rest = line.partition(" ")
        try:
            db.execute("INSERT INTO events VALUES(?,?,?)", (int(float(ts)), "oom", rest[:120]))
        except ValueError:
            pass


def main():
    db = connect()
    boot = read("/proc/sys/kernel/random/boot_id").strip()
    if meta(db, "boot_id") != boot:
        if meta(db, "boot_id") is not None:
            db.execute("INSERT INTO events VALUES(?,?,?)", (int(time.time()), "reboot", ""))
        meta(db, "boot_id", boot)
    db.commit()
    last_oom = time.time()
    prev_total, prev_idle = cpu_times()
    prev_procs, prev_t = proc_scan(), time.time()
    cores = os.cpu_count() or 1
    cpu_v, gpu_v, mem_v, swap_v = [], [], [], []
    cpu_t = gpu_t = gpu_w = None
    hot_until = {}
    while True:
        time.sleep(SUB)
        total, idle = cpu_times()
        dt = total - prev_total
        cpu_v.append(100.0 * (dt - (idle - prev_idle)) / dt if dt else 0.0)
        prev_total, prev_idle = total, idle
        busy, gt, gw, _ = gpu_sample()
        gpu_v.append(busy)
        m, s = meminfo()
        mem_v.append(m)
        swap_v.append(s)
        ct = cpu_temp()
        cpu_t = max(x for x in (cpu_t, ct) if x is not None) if (cpu_t or ct) else None
        gpu_t = max(x for x in (gpu_t, gt) if x is not None) if (gpu_t or gt) else None
        gpu_w = gw if gw is not None else gpu_w
        if len(cpu_v) < PER_ROW:
            continue
        now = time.time()
        ts = int(now // 60 * 60)
        c, g, mm = stats(cpu_v), stats(gpu_v), stats(mem_v)
        db.execute("INSERT OR REPLACE INTO samples VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                   (ts, *c, cpu_t, *g, gpu_t, gpu_w, *mm, max(swap_v)))
        # Top apps: cpu share over the minute, memory (PSS) now, VRAM now.
        procs = proc_scan(with_pss=True)
        el = now - prev_t
        cpu_by, mem_by = {}, {}
        for pid, (app, ticks, rss) in procs.items():
            mem_by[app] = mem_by.get(app, 0) + rss
            old = prev_procs.get(pid)
            if old and el > 0:
                cpu_by[app] = cpu_by.get(app, 0) + (ticks - old[1]) / CLK / el * 100 / cores
        prev_procs, prev_t = procs, now
        for kind, table in (("cpu", cpu_by), ("mem", mem_by), ("gpu", gpu_procs() if GPU else {})):
            for app, value in sorted(table.items(), key=lambda kv: -kv[1])[:TOP]:
                if value > 0:
                    db.execute("INSERT INTO procs VALUES(?,?,?,?)", (ts, kind, app, value))
        # One event per resource (detail = "cpu" or "gpu"), so each popup only marks its own.
        for res, temp, limit in (("cpu", cpu_t, HOT_CPU), ("gpu", gpu_t, HOT_GPU)):
            if now > hot_until.get(res, 0.0) and (temp or 0) >= limit:
                db.execute("INSERT INTO events VALUES(?,?,?)", (ts, "hot", res))
                hot_until[res] = now + 600
        if int(now) // 600 != int(last_oom) // 600:
            oom_events(db, last_oom)
            last_oom = now
        cutoff = ts - RETENTION_DAYS * 86400
        if ts % 3600 < 60:
            for t in ("samples", "procs", "events"):
                db.execute(f"DELETE FROM {t} WHERE ts < ?", (cutoff,))
        db.commit()
        cpu_v, gpu_v, mem_v, swap_v = [], [], [], []
        cpu_t = gpu_t = None


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
