#!/usr/bin/env python3
"""Reads the vitals log for the panel: vitals-query <cpu|gpu|mem> <1|6|24|168>  (hours)  ->  JSON on stdout.

{ "span": seconds, "bucket": seconds,
  "buckets": [{"t": unix, "min": 0-100, "avg": 0-100, "max": 0-100}   # gpu: min is 0 and max is the p95 of the minute maxima ...]   # oldest first, gaps omitted
  "latest":  average of the newest logged minute (what the headline uses for bursty readings like the GPU),
  "calm":    consecutive newest minutes with cpu average under 10% (cpu only),
  "first":   unix time of the oldest logged minute, or null,
  "top":     [{"name": str, "value": number}],   # cpu: average % of the machine, mem/gpu: peak bytes
  "events":  [{"t": unix, "kind": "reboot"|"oom"|"hot", "detail": str}],
  "temp":    {"max": degrees} | null,
  "minutes": number of logged minutes in the window }
"""
import json
import os
import sqlite3
import sys
import time

DB = os.path.expanduser("~/.local/state/terminus-est/vitals.sqlite")
WINDOWS = {"1": (3600, 60), "6": (6 * 3600, 300), "24": (86400, 900), "168": (7 * 86400, 3600)}  # hours: span, bucket


def main():
    kind = sys.argv[1] if len(sys.argv) > 1 else "cpu"
    win = sys.argv[2] if len(sys.argv) > 2 else "6"
    span, bucket = WINDOWS.get(win, WINDOWS["6"])
    out = {"span": span, "bucket": bucket, "buckets": [], "events": [], "top": [], "temp": None, "minutes": 0, "first": None, "latest": None, "calm": 0}
    if kind not in ("cpu", "gpu", "mem") or not os.path.exists(DB):
        print(json.dumps(out))
        return
    db = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    since = int(time.time()) - span
    # A log younger than the window: bucket the data there is, so a fresh log still draws a graph.
    first = db.execute("SELECT MIN(ts) FROM samples WHERE ts >= ?", (since,)).fetchone()[0]
    if first is not None:
        bucket = max(60, min(bucket, ((int(time.time()) - first) // 96 // 60 + 1) * 60))
    cols = {"cpu": ("cpu_min", "cpu_avg", "cpu_max", "cpu_t"), "gpu": ("gpu_min", "gpu_avg", "gpu_max", "gpu_t"),
            "mem": ("mem_min", "mem_avg", "mem_max", "NULL")}[kind]
    if kind == "gpu":
        # The GPU's per-minute maxima nearly always touch 100, so the band carries no information: report the
        # average and the 95th percentile of the minute maxima (in "max"); the panel draws a solid bar and a mark.
        groups = {}
        for t, av, hi in db.execute("SELECT ts, gpu_avg, gpu_max FROM samples WHERE ts >= ? AND gpu_avg IS NOT NULL ORDER BY ts", (since,)):
            groups.setdefault(t // bucket * bucket, []).append((av, hi))
        for t in sorted(groups):
            avs = [g[0] for g in groups[t]]
            his = sorted(g[1] for g in groups[t])
            p95 = his[min(len(his) - 1, int(len(his) * 0.95))]
            out["buckets"].append({"t": t, "min": 0, "avg": sum(avs) / len(avs), "max": p95})
    else:
        for t, lo, av, hi in db.execute(
                f"SELECT ts/{bucket}*{bucket}, MIN({cols[0]}), AVG({cols[1]}), MAX({cols[2]}) FROM samples "
                f"WHERE ts >= ? AND {cols[1]} IS NOT NULL GROUP BY ts/{bucket} ORDER BY 1", (since,)):
            out["buckets"].append({"t": t, "min": lo, "avg": av, "max": hi})
    row = db.execute(f"SELECT COUNT(*), MAX({cols[3]}) FROM samples WHERE ts >= ?", (since,)).fetchone()
    out["minutes"] = row[0]
    last = db.execute(f"SELECT {cols[1]} FROM samples WHERE {cols[1]} IS NOT NULL ORDER BY ts DESC LIMIT 1").fetchone()
    out["latest"] = last[0] if last else None
    if kind == "cpu":  # consecutive newest minutes under 10% average load (the "warm at idle" rule needs three)
        for (avg,) in db.execute("SELECT cpu_avg FROM samples ORDER BY ts DESC LIMIT 30"):
            if avg is None or avg >= 10:
                break
            out["calm"] += 1
    out["first"] = db.execute("SELECT MIN(ts) FROM samples").fetchone()[0]
    out["temp"] = {"max": row[1]} if row[1] is not None else None
    for t, k, d in db.execute("SELECT ts, kind, detail FROM events WHERE ts >= ? ORDER BY ts", (since,)):
        out["events"].append({"t": t, "kind": k, "detail": d})
    if out["minutes"]:
        if kind == "cpu":  # average use: sum of per-minute shares over the minutes the machine was logged
            sql = ("SELECT app, SUM(value) / ? FROM procs WHERE ts >= ? AND kind = 'cpu' "
                   "GROUP BY app ORDER BY 2 DESC LIMIT 5")
            args = (out["minutes"], since)
        else:  # peak resident memory / VRAM over the window
            sql = "SELECT app, MAX(value) FROM procs WHERE ts >= ? AND kind = ? GROUP BY app ORDER BY 2 DESC LIMIT 5"
            args = (since, kind)
        for name, value in db.execute(sql, args):
            out["top"].append({"name": name, "value": value})
    print(json.dumps(out))


if __name__ == "__main__":
    main()
