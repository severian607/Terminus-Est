+/// Presentation only. The animation runs in a throw-away grandchild so that a
+/// crash in it cannot fail the login, and the wait is hard-capped at 1.5 s.
+fn onPasswordAccepted() void {
+    const hook = success_hook orelse return;
+    if (hook.constellation.starCount() == 0) return;
+    const io = hook.state.io;
+
+    const pid = std.posix.system.fork();
+    if (pid < 0) return;
+    if (pid == 0) {
+        playSuccess(hook);
+        std.c._exit(0);
+    }
+
+    const deadline = terminus_common.nowMs(io) + 1500;
+    var status: c_int = 0;
+    while (true) {
+        const r = std.posix.system.waitpid(pid, &status, std.posix.W.NOHANG);
+        if (r != 0) {
+            if (r < 0 and std.posix.errno(r) == .INTR) continue;
+            return;
+        }
+        if (terminus_common.nowMs(io) >= deadline) {
+            _ = std.c.kill(pid, std.posix.SIG.KILL);
+            while (true) {
+                const rr = std.posix.system.waitpid(pid, &status, 0);
+                if (rr < 0 and std.posix.errno(rr) == .INTR) continue;
+                break;
+            }
+            return;
+        }
+        io.sleep(.fromMilliseconds(10), .awake) catch {};
+    }
+}
