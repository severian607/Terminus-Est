diff --git a/src/terminus_common.zig b/src/terminus_common.zig
new file mode 100644
index 0000000..2c385de
--- /dev/null
+++ b/src/terminus_common.zig
@@ -0,0 +1,35 @@
+// Shared helpers for the Terminus-Est presentation additions
+// (password constellation and the "terminus" background animation).
+const std = @import("std");
+
+/// Monotonic milliseconds. Presentation timing only, never used for security decisions.
+pub fn nowMs(io: std.Io) i64 {
+    return std.Io.Timestamp.now(io, .awake).toMilliseconds();
+}
+
+/// Blend `a` towards `b` by `t` (0..1) in 24-bit RGB. Style bits are dropped.
+pub fn mix(a: u32, b: u32, t: f32) u32 {
+    const tt = std.math.clamp(t, 0.0, 1.0);
+    var out: u32 = 0;
+    inline for ([_]u5{ 16, 8, 0 }) |shift| {
+        const ca: f32 = @floatFromInt((a >> shift) & 0xFF);
+        const cb: f32 = @floatFromInt((b >> shift) & 0xFF);
+        const c: u32 = @intFromFloat(@round(ca + (cb - ca) * tt));
+        out |= (c & 0xFF) << shift;
+    }
+    return out;
+}
+
+/// Colour of `color` at intensity `t` over `bg`. Without truecolor there is no
+/// way to dim, so the plain colour is returned.
+pub fn shade(full_color: bool, bg: u32, color: u32, t: f32) u32 {
+    if (!full_color) return color & 0x00FFFFFF;
+    return mix(bg, color, t);
+}
+
+/// Number of rows the "terminus" boot-log ticker occupies at the bottom of the
+/// screen (above the very last row). The constellation keeps clear of them.
+pub fn tickerRows(height: usize) usize {
+    if (height < 14) return 0;
+    return @min(6, height / 8);
+}
