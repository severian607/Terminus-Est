+fn playSuccess(hook: SuccessHook) void {
+    const io = hook.state.io;
+    const t0 = terminus_common.nowMs(io);
+    hook.constellation.startSuccess(t0);
+    while (terminus_common.nowMs(io) - t0 < Constellation.success_total_ms) {
+        TerminalBuffer.clearScreen(false) catch {};
+        for (hook.layers) |layer| {
+            for (layer) |w| {
+                w.update(hook.state) catch {};
