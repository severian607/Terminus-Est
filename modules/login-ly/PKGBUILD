source=("git+$url.git#tag=v${pkgver}"
        "${_zig_deps[@]}"
        "waitpid-eintr.patch::file://${_patchdir}/waitpid-eintr.patch"
        "terminus-constellation.patch::file://${_patchdir}/terminus-constellation.patch")
noextract=("${_zig_deps[@]}")
