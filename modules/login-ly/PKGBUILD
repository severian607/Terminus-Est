# Terminus-Est build: set ZIG=/path/to/zig-0.16.x to build with a Zig 0.16 toolchain
# (Ly 1.4.1 needs >= 0.16.0; the system zig may be newer).

pkgname=ly
pkgver=1.4.1
pkgrel=1.2
pkgdesc="TUI display manager (Terminus-Est: constellation password, night-sky animation)"
arch=(x86_64)
url="https://codeberg.org/fairyglade/ly"
license=('WTFPL')
depends=(pam glibc libxcb)
makedepends=(git zig patch)
install=ly.install
optdepends=('xorg-xauth: for X server sessions'
            'libxcb: for X server sessions')
backup=(
    etc/$pkgname/{config.ini,setup.sh}
    etc/pam.d/ly
)
# makepkg only resolves plain source names next to the PKGBUILD; patches/ is referenced by file:// URL.
_patchdir="$PWD/patches"
_zig_deps=(
    aro-5f5a050569a95ecc40a426f0c3666ae7ef987ede.tar.gz::https://codeberg.org/ziglang/arocc/archive/5f5a050569a95ecc40a426f0c3666ae7ef987ede.tar.gz
    clap-fc1e5cc3f6d9d3001112385ee6256d694e959d2f.tar.gz::https://github.com/Hejsil/zig-clap/archive/fc1e5cc3f6d9d3001112385ee6256d694e959d2f.tar.gz
    ini-3b733e10adc6c4c48050709b97a22258bc2e6156.tar.gz::https://github.com/AshAmetrine/ziglibs-ini/archive/3b733e10adc6c4c48050709b97a22258bc2e6156.tar.gz
    termbox2-c7f241e8888ce243e1748b05c26a42fcfaaad936.tar.gz::https://github.com/AnErrupTion/termbox2/archive/c7f241e8888ce243e1748b05c26a42fcfaaad936.tar.gz
