prepare() {
    cd "$pkgname"
    patch -Np1 -i "$srcdir/waitpid-eintr.patch"
    patch -Np1 -i "$srcdir/terminus-constellation.patch"
    # The decorative boot-log line names this machine's real root device and filesystem (the patch carries the
    # desktop's btrfs on nvme0n1p2 as a placeholder), so build the package on the machine it is installed on.
    local _root _fstype
    # readlink resolves /dev/mapper/root to the kernel's name (dm-0), which is what a real boot log prints.
    _root=$(basename "$(readlink -f "$(findmnt -no SOURCE / | sed 's|\[.*||')")")
    _fstype=$(findmnt -no FSTYPE /)
    if [[ -n $_root && -n $_fstype ]]; then
        if [[ $_fstype == btrfs ]]; then
            sed -i "s|btrfs (nvme0n1p2): using crc32c checksum algorithm|btrfs ($_root): using crc32c checksum algorithm|" src/animations/Terminus.zig
        else
            sed -i "s|btrfs (nvme0n1p2): using crc32c checksum algorithm|$_fstype ($_root): mounted filesystem|" src/animations/Terminus.zig
        fi
    fi
    for dep in "${_zig_deps[@]}"; do
        ${ZIG:-zig} fetch --global-cache-dir ../zig-global-cache "../${dep%%::*}"
    done
}

build() {
    cd "$pkgname"
    ${ZIG:-zig} build \
      --search-prefix /usr \
      -Ddest_directory="$pkgdir" \
      -Dname="ly-dm" \
      --global-cache-dir ../zig-global-cache \
      --system zig-pkg \
      --build-id=sha1 \
      -Dtarget=native-linux.6.6-gnu.2.40 \
      -Dcpu=baseline \
      -Doptimize=ReleaseSafe
}

package() {
    cd "$pkgname"

    ${ZIG:-zig} build \
      --search-prefix /usr \
      -Ddest_directory="$pkgdir" \
      -Dname="ly-dm" \
      --global-cache-dir ../zig-global-cache \
      --system zig-pkg \
      --build-id=sha1 \
      -Dtarget=native-linux.6.6-gnu.2.40 \
      -Dcpu=baseline \
      -Doptimize=ReleaseSafe \
      installexe

    install -Dm644 license.md "$pkgdir/usr/share/licenses/$pkgname/WTFPL"
}
