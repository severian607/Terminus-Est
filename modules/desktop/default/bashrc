# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# All the default Terminus-Est aliases and functions
# (don't mess with these directly, just overwrite them here!)
source ~/.local/share/terminus-est/default/bash/rc

# Show the Terminus-Est system overview once when a new Ghostty window opens.
if [[ ${TERM_PROGRAM:-} == "ghostty" && ${SHLVL:-1} -eq 1 && -z ${TERMINUS_FASTFETCH_SHOWN:-} ]]; then
  export TERMINUS_FASTFETCH_SHOWN=1
  command -v fastfetch >/dev/null && fastfetch
fi

