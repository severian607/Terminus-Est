#!/bin/bash

# terminus:summary=Enable, disable, or toggle the touchpad
# terminus:args=[on|off|toggle]

STATE_CONF="$HOME/.local/state/terminus-est/toggles/hypr/touchpad-disabled.conf"

device="$(terminus-hw-touchpad)"
device_lua=$(jq -Rn --arg value "$device" '$value')

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

enable() {
  hyprctl eval "hl.device({ name = $device_lua, enabled = true })" >/dev/null
  rm -f "$STATE_CONF"
  terminus-swayosd-client --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
}

disable() {
  hyprctl eval "hl.device({ name = $device_lua, enabled = false })" >/dev/null
  mkdir -p "$(dirname "$STATE_CONF")"
  printf 'device {\n    name = %s\n    enabled = false\n}\n' "$device" > "$STATE_CONF"
  terminus-swayosd-client --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_CONF ]]; then enable; else disable; fi ;;
esac
