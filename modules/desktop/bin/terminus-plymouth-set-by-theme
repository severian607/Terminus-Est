#!/bin/bash

# terminus:summary=Set the Plymouth boot theme from an Terminus-Est theme
# terminus:args=<theme-name>
# terminus:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via terminus-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: terminus-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/terminus-est/themes/$theme ]]; then
  theme_dir=~/.config/terminus-est/themes/$theme
else
  theme_dir="$TERMINUS_DESKTOP_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec terminus-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
