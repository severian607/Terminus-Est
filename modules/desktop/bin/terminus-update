#!/bin/bash

# terminus:summary=Update Terminus-Est and system packages
# terminus:args=[-y]
# terminus:examples=terminus update | terminus update -y
# terminus:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $TERMINUS_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env TERMINUS_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/terminus-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\033[0m"' ERR

if [[ $1 == "-y" ]] || terminus-update-confirm; then
  terminus-snapshot create || (($? == 127))
  terminus-update-perform
fi
