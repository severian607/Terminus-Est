#!/bin/bash

# terminus:summary=Display brightness level using SwayOSD on the current monitor.
# terminus:args=<0-100>
# terminus:examples=terminus swayosd brightness 0 | terminus swayosd brightness 50 | terminus swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

terminus-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
